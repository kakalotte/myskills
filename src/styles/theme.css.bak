@import 'tailwindcss';
@import '@fontsource/inter/400.css';
@import '@fontsource/inter/500.css';
@import '@fontsource/inter/600.css';
@import '@fontsource/inter/700.css';
@import '@fontsource/jetbrains-mono/400.css';
@import '@fontsource/jetbrains-mono/500.css';
@import 'material-symbols/outlined.css';

@theme {
  --color-background: #f8f9ff;
  --color-surface: #f8f9ff;
  --color-surface-bright: #f8f9ff;
  --color-surface-dim: #cbdbf5;
  --color-surface-container-lowest: #ffffff;
  --color-surface-container-low: #eff4ff;
  --color-surface-container: #e5eeff;
  --color-surface-container-high: #dce9ff;
  --color-surface-container-highest: #d3e4fe;
  --color-surface-variant: #d3e4fe;
  --color-on-surface: #0b1c30;
  --color-on-surface-variant: #464555;
  --color-on-background: #0b1c30;
  --color-inverse-surface: #213145;
  --color-inverse-on-surface: #eaf1ff;
  --color-outline: #777587;
  --color-outline-variant: #c7c4d8;
  --color-primary: #3525cd;
  --color-on-primary: #ffffff;
  --color-primary-container: #4f46e5;
  --color-on-primary-container: #dad7ff;
  --color-primary-fixed: #e2dfff;
  --color-primary-fixed-dim: #c3c0ff;
  --color-on-primary-fixed: #0f0069;
  --color-on-primary-fixed-variant: #3323cc;
  --color-inverse-primary: #c3c0ff;
  --color-secondary: #006a63;
  --color-on-secondary: #ffffff;
  --color-secondary-container: #99efe5;
  --color-on-secondary-container: #006f67;
  --color-secondary-fixed: #9cf2e8;
  --color-secondary-fixed-dim: #80d5cb;
  --color-on-secondary-fixed: #00201d;
  --color-on-secondary-fixed-variant: #00504a;
  --color-tertiary: #004c76;
  --color-on-tertiary: #ffffff;
  --color-tertiary-container: #00659a;
  --color-on-tertiary-container: #bedfff;
  --color-tertiary-fixed: #cce5ff;
  --color-tertiary-fixed-dim: #93ccff;
  --color-on-tertiary-fixed: #001d31;
  --color-on-tertiary-fixed-variant: #004b73;
  --color-error: #ba1a1a;
  --color-on-error: #ffffff;
  --color-error-container: #ffdad6;
  --color-on-error-container: #93000a;
  --color-surface-tint: #4d44e3;

  --font-sans: 'Segoe UI', 'Inter', 'Microsoft YaHei UI', 'Microsoft YaHei', 'PingFang SC', sans-serif;
  --font-body-lg: 'Segoe UI', 'Inter', 'Microsoft YaHei UI', 'Microsoft YaHei', 'PingFang SC', sans-serif;
  --font-body-md: 'Segoe UI', 'Inter', 'Microsoft YaHei UI', 'Microsoft YaHei', 'PingFang SC', sans-serif;
  --font-body-sm: 'Segoe UI', 'Inter', 'Microsoft YaHei UI', 'Microsoft YaHei', 'PingFang SC', sans-serif;
  --font-headline-lg: 'Segoe UI', 'Inter', 'Microsoft YaHei UI', 'Microsoft YaHei', 'PingFang SC', sans-serif;
  --font-headline-md: 'Segoe UI', 'Inter', 'Microsoft YaHei UI', 'Microsoft YaHei', 'PingFang SC', sans-serif;
  --font-headline-sm: 'Segoe UI', 'Inter', 'Microsoft YaHei UI', 'Microsoft YaHei', 'PingFang SC', sans-serif;
  --font-caption-caps: 'Segoe UI', 'Inter', 'Microsoft YaHei UI', 'Microsoft YaHei', 'PingFang SC', sans-serif;
  --font-mono: 'JetBrains Mono', 'Cascadia Code', Consolas, monospace;
  --font-label-code-md: 'JetBrains Mono', 'Cascadia Code', Consolas, monospace;
  --font-label-code-sm: 'JetBrains Mono', 'Cascadia Code', Consolas, monospace;

  --text-headline-lg: 24px;
  --text-headline-lg--line-height: 32px;
  --text-headline-lg--letter-spacing: -0.02em;
  --text-headline-lg--font-weight: 600;
  --text-headline-md: 18px;
  --text-headline-md--line-height: 24px;
  --text-headline-md--letter-spacing: -0.015em;
  --text-headline-md--font-weight: 600;
  --text-headline-sm: 15px;
  --text-headline-sm--line-height: 20px;
  --text-headline-sm--letter-spacing: -0.01em;
  --text-headline-sm--font-weight: 600;
  --text-body-lg: 14px;
  --text-body-lg--line-height: 22px;
  --text-body-lg--font-weight: 400;
  --text-body-md: 13px;
  --text-body-md--line-height: 18px;
  --text-body-md--font-weight: 400;
  --text-body-sm: 12px;
  --text-body-sm--line-height: 16px;
  --text-body-sm--font-weight: 400;
  --text-label-code-md: 12px;
  --text-label-code-md--line-height: 16px;
  --text-label-code-md--letter-spacing: -0.01em;
  --text-label-code-sm: 12px;
  --text-label-code-sm--line-height: 16px;
  --text-label-code-sm--font-weight: 500;
  --text-caption-caps: 11px;
  --text-caption-caps--line-height: 14px;
  --text-caption-caps--letter-spacing: 0.06em;
  --text-caption-caps--font-weight: 600;

  --spacing: 0.25rem;
  --spacing-space-2xs: 0.125rem;
  --spacing-space-xs: 0.25rem;
  --spacing-space-sm: 0.5rem;
  --spacing-space-md: 0.75rem;
  --spacing-space-lg: 1rem;
  --spacing-space-xl: 1.5rem;
  --spacing-space-2xl: 2rem;
  --spacing-gutter: 0.75rem;
  --spacing-gutter-split: 1rem;

  --radius-control: 4px;
  --radius-card: 8px;
  --radius-pill: 12px;

  --shadow-card: 0 1px 2px rgba(11, 28, 48, 0.04), 0 2px 10px rgba(11, 28, 48, 0.035);
  --shadow-float: 0 10px 32px rgba(11, 28, 48, 0.12), 0 2px 8px rgba(11, 28, 48, 0.06);
  --shadow-dialog: 0 24px 64px rgba(11, 28, 48, 0.22), 0 4px 14px rgba(11, 28, 48, 0.08);
}

@layer base {
  html,
  body,
  #root {
    height: 100%;
  }

  html {
    color-scheme: light;
  }

  body {
    margin: 0;
    padding: 0;
    background: var(--color-background);
    color: var(--color-on-surface);
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 18px;
    overscroll-behavior: none;
    -webkit-font-smoothing: auto;
    text-rendering: optimizeLegibility;
    text-size-adjust: 100%;
  }

  * {
    box-sizing: border-box;
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
  }

  button {
    cursor: pointer;
  }

  button:disabled {
    cursor: not-allowed;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  ::selection {
    background: var(--color-primary-fixed-dim);
    color: var(--color-on-primary-fixed);
  }

  ::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }

  ::-webkit-scrollbar-track {
    background: transparent;
  }

  ::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--color-outline-variant) 72%, transparent);
    border: 3px solid transparent;
    background-clip: content-box;
    border-radius: 999px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: color-mix(in srgb, var(--color-outline) 55%, transparent);
    border: 3px solid transparent;
    background-clip: content-box;
  }

  :focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-primary) 72%, white);
    outline-offset: 2px;
  }
}

@layer components {
  .material-symbols-outlined {
    font-variation-settings:
      'FILL' 0,
      'wght' 400,
      'GRAD' 0,
      'opsz' 20;
    user-select: none;
    flex: none;
  }

  .material-symbols-outlined.filled {
    font-variation-settings:
      'FILL' 1,
      'wght' 500,
      'GRAD' 0,
      'opsz' 20;
  }

  .window-drag {
    -webkit-app-region: drag;
    app-region: drag;
  }

  .window-no-drag {
    -webkit-app-region: no-drag;
    app-region: no-drag;
  }

  .hairline {
    box-shadow: inset 0 -1px 0 color-mix(in srgb, var(--color-outline-variant) 42%, transparent);
  }

  .surface-grid {
    background-image:
      linear-gradient(
        to right,
        color-mix(in srgb, var(--color-outline-variant) 16%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--color-outline-variant) 16%, transparent) 1px,
        transparent 1px
      );
    background-size: 28px 28px;
  }

  .md-body {
    color: var(--color-on-surface-variant);
    font-size: 13px;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  .md-body > :first-child {
    margin-top: 0;
  }

  .md-body > :last-child {
    margin-bottom: 0;
  }

  .md-body h1,
  .md-body h2,
  .md-body h3,
  .md-body h4 {
    color: var(--color-on-surface);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    margin: 1.35em 0 0.6em;
  }

  .md-body h1 {
    font-size: 21px;
    padding-bottom: 8px;
    border-bottom: 1px solid color-mix(in srgb, var(--color-outline-variant) 45%, transparent);
  }

  .md-body h2 {
    font-size: 17px;
  }

  .md-body h3 {
    font-size: 15px;
  }

  .md-body h4 {
    font-size: 13px;
  }

  .md-body p {
    margin: 0.7em 0;
  }

  .md-body ul,
  .md-body ol {
    margin: 0.7em 0;
    padding-left: 1.45em;
  }

  .md-body ul {
    list-style: disc;
  }

  .md-body ol {
    list-style: decimal;
  }

  .md-body li {
    margin: 0.25em 0;
  }

  .md-body li::marker {
    color: var(--color-primary);
  }

  .md-body a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .md-body code {
    font-family: var(--font-mono);
    font-size: 12px;
    background: var(--color-surface-container-low);
    border: 1px solid color-mix(in srgb, var(--color-outline-variant) 40%, transparent);
    border-radius: 4px;
    padding: 1px 5px;
    color: var(--color-on-surface);
  }

  .md-body pre {
    margin: 1em 0;
    padding: 12px 14px;
    background: var(--color-surface-container-low);
    border: 1px solid color-mix(in srgb, var(--color-outline-variant) 45%, transparent);
    border-radius: 8px;
    overflow-x: auto;
  }

  .md-body pre code {
    background: transparent;
    border: 0;
    padding: 0;
    font-size: 12px;
    line-height: 1.65;
  }

  .md-body blockquote {
    margin: 1em 0;
    padding: 2px 0 2px 12px;
    border-left: 3px solid var(--color-primary-fixed-dim);
    color: var(--color-on-surface-variant);
  }

  .md-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 1em 0;
    font-size: 12.5px;
  }

  .md-body th,
  .md-body td {
    border: 1px solid color-mix(in srgb, var(--color-outline-variant) 55%, transparent);
    padding: 6px 9px;
    text-align: left;
    vertical-align: top;
  }

  .md-body th {
    background: var(--color-surface-container-low);
    color: var(--color-on-surface);
    font-weight: 600;
  }

  .md-body hr {
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-outline-variant) 45%, transparent);
    margin: 1.5em 0;
  }

  .md-body img {
    max-width: 100%;
    border-radius: 8px;
  }

  .toast-enter {
    animation: toast-in 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .dialog-enter {
    animation: dialog-in 160ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
}

@keyframes toast-in {
  from {
    opacity: 0;
    transform: translateY(10px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes dialog-in {
  from {
    opacity: 0;
    transform: translateY(8px) scale(0.985);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

